# ==============================================================================
# FinTrack Supabase Environment Configuration (.env.example)
# Copy this to .env.local and replace with your actual Supabase credentials
# Found in: Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (safe for client-side browsers)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
-